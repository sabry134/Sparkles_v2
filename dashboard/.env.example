NODE_ENV=development
DASHBOARD_PORT=3001
DASHBOARD_PUBLIC_URL=http://localhost:3001
DASHBOARD_FRONTEND_URL=http://localhost:5173

# Copy these values from the Discord Developer Portal. Never expose either secret
# through VITE_* variables or commit the completed .env file.
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token

# Permission integer used by the per-server bot installation link.
# Generate the exact permissions your bot needs in Developer Portal > OAuth2.
DISCORD_BOT_PERMISSIONS=your-permission-integer

# Generate a unique value with at least 64 random characters.
SESSION_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-64-characters
SESSION_STORE_PATH=.data/sessions.enc.json

# Paths are resolved relative to this dashboard directory.
BOT_STORE_PATH=../data/store.json
BOT_CONFIG_PATH=../config/bot.json

# Set to 1 only when the dashboard is behind a trusted reverse proxy.
TRUST_PROXY=0
