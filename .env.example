DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id
DEFAULT_LOCALE=en

# MongoDB is the shared persistence layer for both the bot and dashboard.
# Put your MongoDB Atlas/Server connection string here.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sparkles

BOT_CONFIG_PATH=./config/bot.json
DASHBOARD_URL=http://localhost:5173

# Optional provider-backed commands
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TOPGG_TOKEN=
TANKI_RATINGS_API_URL=
PASTEBIN_API_KEY=
PASTEBIN_USER_KEY=
